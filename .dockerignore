.git/
.gitignore

# Local environments and generated Python files
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Never send local credentials or environment files to the build context.
.env
.env.*
!.env.example

# Local build, packaging, and editor artifacts
build/
dist/
*.egg-info/
*.log
.DS_Store
*.swp
